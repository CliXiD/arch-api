# arch-api configuration. Dummy values for the hub's local stack; real values come from the
# environment (External Secrets in Kubernetes). [SPEC-operations-05]

# Database [ADR-0004] [ADR-0014]
DATABASE_URL=postgres://arch:arch@localhost:5432/arch?sslmode=disable
# Used by `migrate` only; defaults to DATABASE_URL.
MIGRATE_DATABASE_URL=postgres://arch:arch@localhost:5432/arch?sslmode=disable

# HTTP (defaults :8080 and :9090)
HTTP_ADDR=:8080
METRICS_ADDR=:9090
# Comma-separated origins allowed by CORS; empty sends no CORS headers.
CORS_ORIGINS=http://localhost:5173
# debug, info (default), warn or error
LOG_LEVEL=debug

# Identity: Keycloak realm `arch` [ADR-0008]
OIDC_ISSUER=http://localhost:8180/realms/arch
OIDC_AUDIENCE=arch-api
# Optional; discovered from <OIDC_ISSUER>/.well-known/openid-configuration when unset.
# OIDC_JWKS_URL=http://keycloak:8080/realms/arch/protocol/openid-connect/certs

# Tracing [ADR-0011]: off while the endpoint is unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# grpc (default) or http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
